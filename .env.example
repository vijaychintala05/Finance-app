# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL (required in production; in-memory mode is test/development only)
DATABASE_URL=postgresql://firmbooks:change-me@127.0.0.1:5432/firmbooks
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_QUERY_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=15000

# Generate at least 32 random bytes; never commit the real value.
JWT_SECRET=replace-with-a-cryptographically-random-secret-of-at-least-32-characters

# Comma-separated browser origins allowed to call the API cross-origin.
# Same-origin requests are allowed automatically.
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
JSON_BODY_LIMIT=1mb

# Optional financial workflows require both source-code certification and this
# deployment flag. The current build certifies none, so values here are ignored.
TRUSTED_FINANCE_FEATURES=

# Test/development only. Never enable an in-memory database in production.
DATABASE_MODE=
USE_PG_MEM=false
