# Copy this file to .env beside compose.nas.yaml on the NAS.
# Use only letters and numbers for POSTGRES_PASSWORD because it is embedded in
# DATABASE_URL. Do not commit or share the completed .env file.
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password
JWT_SECRET=replace_with_at_least_32_random_characters
AUTH_ENCRYPTION_KEY=replace_with_at_least_32_random_characters_for_mfa_encryption

# MinisCloud Docker host port. The default opens FirmBooks at:
# http://192.168.1.9:55000
APP_PORT=55000
APP_ORIGIN=http://192.168.1.9:55000

# Optional SMTP Configuration for Transactional Invitations & Password Resets
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@yourfirm.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM="FirmBooks Security" <security@yourfirm.com>

# Keep false for direct LAN or private VPN access. Set true only when a trusted
# reverse proxy terminates HTTPS immediately in front of this container.
TRUST_PROXY=false
DB_POOL_MAX=10
