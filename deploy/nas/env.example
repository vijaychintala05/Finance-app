# Copy this file to the repository root as .env on the NAS.
NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://firmbooks:replace-me@127.0.0.1:5432/firmbooks
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_QUERY_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=15000

# Generate a unique random value of at least 32 characters.
JWT_SECRET=replace-with-a-cryptographically-random-secret
ALLOWED_ORIGINS=https://accounting.example.com
TRUST_PROXY=true
JSON_BODY_LIMIT=1mb

TRUSTED_FINANCE_FEATURES=
DATABASE_MODE=
USE_PG_MEM=false
